# Repeat bridge: a KB chord with repeat = true is served (outside Citrix Viewer)
# by Karabiner emitting one of these otherwise unused chords, which Hammerspoon
# binds with key repeat. (karabiner key_code, karabiner modifiers, hs key, hs mods)
BRIDGE_SLOTS = [
    (f"f{n}", ["left_control", "left_option", "left_command"] + (["left_shift"] if sh else []),
     f"f{n}", ["ctrl", "alt", "cmd"] + (["shift"] if sh else []))
    for sh in (False, True) for n in (16, 17, 18, 19)
]

def port_action_ok(name: str) -> bool:
    """A namespaced action ("osd.volume-up") defined by an installed omarchy-port port."""
    import re as _re
    m = _re.match(r"^([a-z0-9-]+)\.[a-z0-9.-]+$", name or "")
    if not m:
        return False
    import os as _os
    pid = m.group(1)
    candidates = [Path.home() / ".hammerspoon/omarchy/ports" / f"{pid}.lua"]
    # deploy.sh exports OMARCHY_PORTS_SRC=<repo>/ports so bundled ports count before install
    for d in filter(None, _os.environ.get("OMARCHY_PORTS_SRC", "").split(":")):
        candidates.append(Path(d) / pid / "hammerspoon" / f"{pid}.lua")
    for mod in candidates:
        try:
            if f'["{name}"]' in mod.read_text():
                return True
        except OSError:
            pass
    return False


